# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# Claude Code te ayuda a llenar estos valores durante el setup.
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: meta | twilio
WHATSAPP_PROVIDER=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ────────────
# Configurar en: https://developers.facebook.com
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify

# ── Twilio (si WHATSAPP_PROVIDER=twilio) ──────────────────
# Configurar en: https://twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Stock en vivo (Google Sheet) ──────────────────────────
# URL del Google Sheet publicado como CSV con columnas: Nombre | SKU | Stock | Precio Venta
# Publicar en: Archivo → Compartir → Publicar en la web → (hoja) → CSV
# STOCK_SHEET_CSV_URL=

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Optimización de costos / tokens (opcionales) ──────────
# Máximo de tokens de la respuesta al cliente (WhatsApp usa mensajes cortos).
# MAX_TOKENS_RESPUESTA=500
# Modelo usado para resumir conversaciones largas (Haiku es ~3× más barato).
# MODELO_RESUMEN=claude-haiku-4-5

# ── Handoff IA / humano ───────────────────────────────────
# Minutos de inactividad tras los cuales una conversación en modo humano
# vuelve sola a la IA. 0 = desactivado.
AUTO_RETORNO_MINUTOS=60

# Token para proteger los endpoints /admin (rotarlo si se filtró)
# ADMIN_TOKEN=

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Produccion (PostgreSQL en Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
